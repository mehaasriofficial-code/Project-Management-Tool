# Copy this file to backend/.env and fill in real values.

# MongoDB connection string. For a local MongoDB install this is usually:
MONGODB_URI=mongodb://localhost:27017/project-management-tool

# Any long random string — used to sign JWTs. Do not reuse this example value.
JWT_SECRET=replace_this_with_a_long_random_string

# How long a login token stays valid.
JWT_EXPIRE=7d

# Port the server listens on. The frontend is served from this same port.
PORT=5000
